rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.admin == true;
    }

    function isValidProduct(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.price is number && data.price >= 0
        && data.stock is number && data.stock >= 0
        && data.category is string;
    }

    function isValidOrder(data) {
      return data.orderCode is string && data.orderCode.size() >= 4
        && data.finalAmount is number && data.finalAmount >= 0
        && data.items is list && data.items.size() > 0
        && data.customer is map
        && data.customer.fullName is string && data.customer.fullName.size() > 0
        && data.customer.phone is string && data.customer.phone.size() >= 10;
    }

    // 1. Products:
    // - Public catalog reading allowed
    // - Full Create/Update/Delete strictly restricted to verified Admin with strict schema validation
    // - No anonymous or standard client can directly mutate products
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(request.resource.data);
      allow update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // 2. Orders:
    // - Customers can ONLY create valid orders
    // - Customers CANNOT list all orders (prevents scraping all customer records)
    // - Single order read: ONLY permitted for Admin or the verified Customer owner (customerUid/customerId matching auth UID)
    // - Blanket public read (allow get: if true) is strictly FORBIDDEN to protect customer PII (name, phone, address)
    // - Order modification (status, notes, tracking) and deletion strictly Admin
    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data);
      allow get: if isAdmin() || (
        isAuthenticated() && (
          (resource.data.customerUid is string && resource.data.customerUid == request.auth.uid) ||
          (resource.data.customerId is string && resource.data.customerId == request.auth.uid)
        )
      );
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // 3. Store Settings:
    // - Public read for branding and store display
    // - Modification strictly Admin only
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Audit logs:
    // - Management audit logs strictly restricted to Admin
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // 5. Analytics & Visitor stats:
    // - Management analytics data strictly restricted to Admin
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }

    // 6. Admin Secrets:
    // - Strictly forbidden from all direct client queries
    match /admin_secrets/{docId} {
      allow read, write: if false;
    }
  }
}
