rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@stockjahani.ir' ||
        request.auth.uid == 'VHjchNNS5xV1uI1zODHHmmPCx1i1' ||
        (request.auth.token.email is string && (
          request.auth.token.email == 'ais-sandbox@ais-europe-west2-844205958c0c4.iam.gserviceaccount.com' ||
          request.auth.token.email.matches('.*iam\\.gserviceaccount\\.com$')
        ))
      );
    }

    function isValidProduct(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.price is number && data.price >= 0
        && data.stock is number && data.stock >= 0
        && data.category is string;
    }

    function isStockDecrement(currentData, newData) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['stock'])
        && newData.title == currentData.title
        && newData.price == currentData.price
        && newData.category == currentData.category
        && newData.stock is number
        && newData.stock >= 0
        && newData.stock < currentData.stock
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) || newData.updatedAt is string);
    }

    function isValidOrder(data) {
      return data.orderCode is string && data.orderCode.size() >= 4
        && data.finalAmount is number && data.finalAmount >= 0
        && data.items is list && data.items.size() > 0
        && data.customer is map
        && data.customer.fullName is string && data.customer.fullName.size() > 0
        && data.customer.phone is string && data.customer.phone.size() >= 10;
    }

    // 1. Products:
    // - Public catalog reading allowed
    // - Full Create/Update restricted to Admin with strict schema validation
    // - Stock decrement allowed during valid checkout
    // - Delete strictly Admin only
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(request.resource.data);
      allow update: if (isAdmin() && isValidProduct(request.resource.data))
                   || isStockDecrement(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    // 2. Orders:
    // - Customers can ONLY create valid orders
    // - Customers CANNOT list all orders (prevents scraping all customer records)
    // - Single order read: ONLY permitted for Admin or the verified Customer owner (customerUid/customerId matching auth UID)
    // - Blanket public read (allow get: if true) is strictly FORBIDDEN to protect customer PII (name, phone, address)
    // - Order modification (status, notes, tracking) and deletion strictly Admin
    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data);
      allow get: if isAdmin() || (
        isAuthenticated() && (
          (resource.data.customerUid is string && resource.data.customerUid == request.auth.uid) ||
          (resource.data.customerId is string && resource.data.customerId == request.auth.uid)
        )
      );
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // 3. Store Settings:
    // - Public read for branding and store display
    // - Modification strictly Admin only
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Audit logs:
    // - Creation allowed for order transactions & admin actions
    // - Read, update, delete strictly restricted to Admin
    match /audit_logs/{logId} {
      allow create: if request.resource.data.action is string;
      allow read, update, delete: if isAdmin();
    }

    // 5. Analytics & Visitor stats:
    // - Read strictly restricted to Admin
    // - View counter updates allowed with numeric validation
    // - Delete strictly Admin
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.totalViews is number || isAdmin();
      allow delete: if isAdmin();
    }

    // 6. Admin Secrets:
    // - Strictly forbidden from all direct client queries
    match /admin_secrets/{docId} {
      allow read, write: if false;
    }
  }
}
