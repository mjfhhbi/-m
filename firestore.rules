rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products: public can read, anyone can manage
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    // Orders: public can create new orders and track them
    match /orders/{orderId} {
      allow read, create, update, delete: if true;
    }
    // Settings: public can read settings, write permitted
    match /settings/{settingId} {
      allow read, write: if true;
    }
    // Analytics and visitors
    match /analytics/{docId} {
      allow read, write: if true;
    }
    // Audit Logs: readable and writable for logging mutations
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
